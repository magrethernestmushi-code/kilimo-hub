# ══════════════════════════════════════════
#  KILIMO HUB — Environment Variables
#  Copy this file to ".env" for local use.
#  On Render, set these under your service's "Environment" tab instead —
#  never commit real secrets to the repo.
# ══════════════════════════════════════════

# DATABASE — Render Postgres gives you this automatically when you add a
# PostgreSQL database and link it to this service ("Internal Database URL").
DATABASE_URL=postgresql://postgres:password@localhost:5432/kilimohub

# JWT SECRET — a long random string. Generate your own; do not reuse this example.
# You can ask Claude to generate one for you to paste directly into Render.
SECRET_KEY=change-this-to-a-random-32-plus-character-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# APP SETTINGS
APP_NAME=Digital Kilimo Hub
PORT=8000

# CORS — comma-separated origins allowed to call this API.
# Use * only for early testing; lock this down to your real domain(s) later.
ALLOWED_ORIGINS=*

# FIRST ADMIN ACCOUNT — set these once, deploy, then you may remove them.
# Leave them unset and no admin account will be auto-created (the server
# will just log a warning instead of shipping a default password).
FIRST_ADMIN_PHONE=
FIRST_ADMIN_PASSWORD=
